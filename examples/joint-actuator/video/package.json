{
  "name": "joint-actuator-teaser",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "dev": "npx --yes hyperframes@0.8.185 preview",
    "check": "npx --yes hyperframes@0.8.185 check",
    "render": "npx --yes hyperframes@0.8.185 render --quality delivery --fps 30 --workers 2 --browser-gpu --output out/joint-actuator.mp4",
    "teaser": "python ../make_teaser.py out/joint-actuator.mp4 ../../../assets/joint-actuator.gif"
  },
  "dependencies": {
    "gsap": "3.14.2",
    "three": "0.181.2"
  },
  "devDependencies": {
    "esbuild": "0.27.4"
  }
}
